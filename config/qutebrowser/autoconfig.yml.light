# If a config.py file exists, this file is ignored unless it's explicitly loaded
# via config.load_autoconfig(). For more information, see:
# https://github.com/qutebrowser/qutebrowser/blob/master/doc/help/configuring.asciidoc#loading-autoconfigyml
# DO NOT edit this file by hand, qutebrowser will overwrite it.
# Instead, create a config.py - see :help for details.

config_version: 2
settings:
  bindings.commands:
    global:
      normal:
        ',H': spawn mpv {url}
        ',h': hint links spawn mpv {hint-url}
        J: tab-prev
        K: tab-next
  colors.webpage.preferred_color_scheme:
    global: light
  content.geolocation:
    https://www.gadgets360.com: false
    https://www.lenovo.com: false
    https://www.olx.in: false
    https://www.speedtest.net: false
  content.javascript.enabled:
    global: true
  content.notifications.enabled:
    https://balator.info: false
    https://filme.imyfone.com: false
    https://howtodo.rocks: false
    https://ng.opera.news: false
    https://postimg.cc: false
    https://www.easeus.com: false
    https://www.reddit.com: false
    https://www.youtube.com: false
  editor.command:
    global:
    - foot
    - --
    - nvim
    - '{file}'
  hints.chars:
    global: arstdhneio
  url.default_page:
    global: about:blank
  url.searchengines:
    global:
      DEFAULT: https://google.com/search?q={}
  url.start_pages:
    global: file:///home/monochrome/.config/qutebrowser/blankpage.html
